(version 1)

(rule "Clearance min 0.125mm - Inner Layers"
  (condition "(A.Layer == 'In1.Cu' || A.Layer == 'In2.Cu' || A.Layer == 'In3.Cu' || A.Layer == 'In4.Cu') && (B.Layer == 'In1.Cu' || B.Layer == 'In2.Cu' || B.Layer == 'In3.Cu' || B.Layer == 'In4.Cu')")
  (constraint clearance (min 0.125mm))
)

#----------------------- PCIe -----------------------
(rule "(pcie_inner"
	(layer inner)
	(condition "(A.NetClass == '85Ohm-diff_PCIe3.0')")
	(constraint track_width (opt 0.15mm))
	(constraint diff_pair_gap (min 0.15mm) (opt 0.15mm) (max 0.40mm))
#	(constraint diff_pair_uncoupled (max 2mm))
)
(rule "(pcie_outer"
	(layer outer)
	(condition "(A.NetClass == '85Ohm-diff_PCIe3.0')")
	(constraint track_width (opt 0.175mm))
	(constraint diff_pair_gap (min 0.12mm) (opt 0.12mm) (max 0.40mm))
#	(constraint diff_pair_uncoupled (max 2mm))
)

(rule "(pcie_clk_inner"
	(layer inner)
	(condition "(A.NetClass == '100Ohm-diff_PCIe3.0_CLK')")
	(constraint track_width (opt 0.125mm))
	(constraint diff_pair_gap (min 0.22mm) (opt 0.22mm) (max 0.40mm))
#	(constraint diff_pair_uncoupled (max 2mm))
)
(rule "(pcie_clk_outer"
	(layer outer)
	(condition "(A.NetClass == '100Ohm-diff_PCIe3.0_CLK')")
	(constraint track_width (opt 0.125mm))
	(constraint diff_pair_gap (min 0.125mm) (opt 0.125mm) (max 0.40mm))
#	(constraint diff_pair_uncoupled (max 2mm))
)

#---------------------------------------------
